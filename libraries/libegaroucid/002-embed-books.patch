+int egaroucid_get_resource_size(const char* resource_name) {
+    int resource_size;
+    if (strcmp(resource_name, "eval")) {
+        resource_size = sizeof(eval_binary)/sizeof(uint8_t);
+    }else if (strcmp(resource_name, "eval_move_ordering_end")) {
+        resource_size = sizeof(eval_move_ordering_end_binary)/sizeof(uint8_t);
+    }else if (strcmp(resource_name, "book")) {
+        resource_size = sizeof(book_binary)/sizeof(uint8_t);
+    }else if (strcmp(resource_name, "hash25")) {
+        resource_size = sizeof(hash25_binary)/sizeof(uint8_t);
+    }else if (strcmp(resource_name, "hash26")) {
+        resource_size = sizeof(hash26_binary)/sizeof(uint8_t);
+    }else if (strcmp(resource_name, "hash27")) {
+        resource_size = sizeof(hash27_binary)/sizeof(uint8_t);
+    }
+    return resource_size;
+}
+
+uint8_t egaroucid_get_resource_byte(const char* resource_name, int resource_byte) {
+    uint8_t byte;
+    if (strcmp(resource_name, "eval")) {
+        byte = eval_binary[resource_byte];
+    }else if (strcmp(resource_name, "eval_move_ordering_end")) {
+        byte = eval_move_ordering_end_binary[resource_byte];
+   }else if (strcmp(resource_name, "book")) {
+        byte = book_binary[resource_byte];
+   }else if (strcmp(resource_name, "hash25")) {
+        byte = hash25_binary[resource_byte];
+   }else if (strcmp(resource_name, "hash26")) {
+        byte = hash26_binary[resource_byte];
+    }else if (strcmp(resource_name, "hash27")) {
+        byte = hash27_binary[resource_byte];
+    }
+    return byte;
