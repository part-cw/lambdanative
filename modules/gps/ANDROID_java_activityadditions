@Override
public void onStatusChanged(String provider, int status, Bundle extras) {
  // Deprecated but still required by interface
}

GnssStatus.Callback gnssCallback = new GnssStatus.Callback() {
  @Override
  public void onSatelliteStatusChanged(GnssStatus status) {
    int satellitesInView = status.getSatelliteCount();
    int satellitesInFix = 0;

    for (int i = 0; i < satellitesInView; i++) {
      if (status.usedInFix(i)) satellitesInFix++;
    }

    satelliteEvent(satellitesInView, satellitesInFix);
  }
};

public void toggleGPS(int status){
  if (status == 1) {
    gpsStatus = 1;
    runOnUiThread(new Runnable() {
      public void run() {
        locationManager.requestLocationUpdates(provider, 1000, 1, locationlistener);

        if (gnssCallback == null) {
          gnssCallback = new GnssStatus.Callback() {
            @Override
            public void onSatelliteStatusChanged(GnssStatus status) {
              int satellites = status.getSatelliteCount();
              int satellitesInFix = 0;
              for (int i = 0; i < satellites; i++) {
                if (status.usedInFix(i)) satellitesInFix++;
              }
              satelliteEvent(satellites, satellitesInFix);
            }
          };
          locationManager.registerGnssStatusCallback(gnssCallback);
        }
      }
    });

  } else {
    gpsStatus = 0;
    locationManager.removeUpdates(locationlistener);
    if (gnssCallback != null && locationManager != null) {
      locationManager.unregisterGnssStatusCallback(gnssCallback);
    }
  }
}



// Check if location services are enabled on the device
public int isLocationServiceEnabled() {
  String enabledProviders = Settings.Secure.getString(getContentResolver(), Settings.Secure.LOCATION_PROVIDERS_ALLOWED);
  return (enabledProviders == null || enabledProviders.isEmpty()) ? 0 : 1;
}
